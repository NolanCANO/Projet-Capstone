# AWS Region
AWS_REGION=eu-west-1

# AWS Profile (for SSO)
AWS_PROFILE=aws-labs

# IAM Role ARNs (get these from: npm run get-roles)
# Or run: aws iam get-role --role-name APIGatewayDynamoDBServiceRole --query 'Role.Arn' --output text --profile aws-labs
DYNAMODB_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/APIGatewayDynamoDBServiceRole
S3_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/APIGatewayS3ServiceRole

# Resource Names (customize if needed)
BUCKET_NAME=maritime-surveillance-ships-photos
TABLE_NAME=maritime-ships

# API Gateway Configuration
API_NAME=maritime-surveillance-api
STAGE_NAME=prod

# Optional: API Gateway ID (filled after deployment)
# API_GATEWAY_ID=
